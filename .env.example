# ============================================================================
#  docker-compose.yml 이 읽는 값들
#  ---------------------------------------------------------------------------
#    cp .env.example .env
#  하고 채운 뒤 `docker compose up -d --build` 하세요.
#  .env 는 커밋하지 않습니다(.gitignore).
# ============================================================================

# ---------------------------------------------------------------------- DB
DB_NAME=fit
DB_USER=fit
# 아무 문자열이나가 아니라, 만들어 낸 값이어야 합니다.
#   openssl rand -base64 24
DB_PASSWORD=

# --------------------------------------------------------------------- 토큰
# 액세스 토큰에 서명하는 열쇠입니다. 32바이트 이상.
#   openssl rand -base64 48
# 바꾸면 이미 나가 있는 토큰이 전부 무효가 됩니다(전원 재로그인).
JWT_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --------------------------------------------------------------------- 설치
# 최초 운영자를 만들 때 화면에서 한 번 입력하는 값입니다. 이게 없으면
# 배포 직후 아무나 첫 운영자 자리를 가져갈 수 있습니다.
#   openssl rand -hex 16
# 운영자를 만든 뒤에는 비워 두고 다시 띄우는 편이 좋습니다.
SETUP_TOKEN=

# --------------------------------------------------------------------- 쿠키
# 리프레시 쿠키에 Secure 를 붙일지.
#
#   true  → HTTPS 로만 실립니다. 도메인에 인증서를 붙였거나 Cloudflare 터널
#           뒤에 있다면 반드시 true.
#   false → http://localhost 로 시험할 때만. 이대로 인터넷에 올리면
#           리프레시 토큰이 평문으로 오갑니다.
SECURE_COOKIE=false

# ---------------------------------------------------------------------- 기타
# 서버가 보는 "지금" 과 "오늘".
#
# 비워 두면 컨테이너가 UTC 로 돌고, 정해 둔 시각에 도는 일들이 아홉 시간
# 어긋납니다 — 전날 저녁 여덟 시에 가야 할 내일 알림이 새벽 다섯 시에
# 갑니다. 저장되는 시각은 이 값과 무관하게 정확합니다.
#
# 한국 밖에서 돌린다면 그곳 이름으로 바꾸세요(예: Asia/Tokyo).
TZ=Asia/Seoul

# nginx 를 거쳐 오는 브라우저는 같은 주소라 CORS 를 타지 않습니다.
# 화면을 따로 띄워(expo start --web, 기본 8081) 붙일 때만 씁니다.
CORS_ORIGINS=http://localhost:8081

# 웹을 호스트의 어느 포트로 열지.
WEB_PORT=8080

# 그 포트를 어느 주소에 묶을지.
#
#   0.0.0.0    같은 공유기 안의 다른 기기(폰 등)에서도 붙을 수 있습니다.
#   127.0.0.1  이 서버 안에서만. 터널로 열 때는 이쪽이 맞습니다 —
#              바깥에서 들어오는 길을 터널 하나로 좁힙니다.
WEB_BIND=0.0.0.0

# ------------------------------------------------------------------- 지도
# 구글 지도 키 (선택).
#
# 넣으면 일정 화면에 지도가 뜨고, 장소를 이름으로 찾아 좌표를 채웁니다.
# 없으면 지도와 검색이 조용히 빠지고 나머지는 그대로 돕니다.
#
# 필요한 API: Maps JavaScript API, Places API
# 이 값은 브라우저 번들에 박히므로 구글 콘솔에서 HTTP 리퍼러 제한을 거세요.
# 바꾸면 프론트 이미지를 다시 빌드해야 반영됩니다(--build).
EXPO_PUBLIC_GMAPS_KEY=

# 장소 검색용 서버 키.
#
# 위 키와 **다른 것**이어야 합니다. 위 키는 HTTP 리퍼러로 묶여 있는데,
# 서버가 부를 때는 리퍼러가 없어 거절당합니다. 이 키는 서버 IP 로 묶으세요.
#
# 필요한 API: Places API
# 비워 두면 검색이 꺼지고, 화면은 좌표를 직접 넣는 길을 안내합니다.
# 이 값은 서버에만 있고 브라우저·앱 번들에는 들어가지 않습니다.
GOOGLE_MAPS_KEY=

# 구글로 로그인하기 — Google Cloud 콘솔의 "OAuth 2.0 클라이언트 ID"(웹).
# 위의 지도 키와 다른 것입니다. 비밀이 아니라 브라우저에도 나갑니다.
# 승인된 자바스크립트 원본에 이 서비스 주소를 넣어 두어야 합니다.
# 비워 두면 구글 로그인이 꺼지고 화면에 단추도 안 뜹니다.
GOOGLE_CLIENT_ID=

# 앱에서 오는 로그인 토큰의 임자들. 쉼표로 나열합니다.
#
# 구글은 쪽마다 다른 클라이언트 ID 를 내줍니다(웹/iOS/안드로이드). 그리고
# ID 토큰의 aud 에는 그것을 받아 간 쪽의 ID 가 박혀 옵니다. 위 것 하나만
# 보면 앱에서 온 토큰이 전부 거절됩니다 - 남의 앱 토큰을 막으려는 검사인데
# 우리 앱까지 막는 셈이 됩니다.
#
# 예) GOOGLE_AUDIENCES=1234-ios.apps.googleusercontent.com,5678-android.apps.googleusercontent.com
#
# 비워 두면 웹 것 하나만 봅니다. 앱 로그인을 안 쓰면 그대로 두세요.
# 쉼표 사이에 빈 자리가 생기지 않게 하세요 - 서버가 걸러 내기는 하지만,
# 그 자리는 원래 "아무 토큰이나 통과" 가 되는 곳입니다.
GOOGLE_AUDIENCES=

# ----------------------------------------------------------------- 터널
# Cloudflare 터널 토큰 (선택).
#
# 공유기 포트를 열지 않고 밖에서 들어올 수 있게 합니다. Zero Trust 대시보드
# > Networks > Tunnels 에서 터널을 만들면 나오는 토큰입니다.
#
#   docker compose --profile tunnel up -d --build
#
# 토큰은 그 자체로 터널에 붙을 수 있는 자격이라 비밀번호처럼 다루세요.
TUNNEL_TOKEN=
