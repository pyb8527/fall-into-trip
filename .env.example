# ============================================================================
#  docker-compose.yml 이 읽는 값들
#  ---------------------------------------------------------------------------
#    cp .env.example .env
#  하고 채운 뒤 `docker compose up -d --build` 하세요.
#  .env 는 커밋하지 않습니다(.gitignore).
# ============================================================================

# ---------------------------------------------------------------------- DB
DB_NAME=fit
DB_USER=fit
# 아무 문자열이나가 아니라, 만들어 낸 값이어야 합니다.
#   openssl rand -base64 24
DB_PASSWORD=

# --------------------------------------------------------------------- 토큰
# 액세스 토큰에 서명하는 열쇠입니다. 32바이트 이상.
#   openssl rand -base64 48
# 바꾸면 이미 나가 있는 토큰이 전부 무효가 됩니다(전원 재로그인).
JWT_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --------------------------------------------------------------------- 설치
# 최초 운영자를 만들 때 화면에서 한 번 입력하는 값입니다. 이게 없으면
# 배포 직후 아무나 첫 운영자 자리를 가져갈 수 있습니다.
#   openssl rand -hex 16
# 운영자를 만든 뒤에는 비워 두고 다시 띄우는 편이 좋습니다.
SETUP_TOKEN=

# --------------------------------------------------------------------- 쿠키
# 리프레시 쿠키에 Secure 를 붙일지.
#
#   true  → HTTPS 로만 실립니다. 도메인에 인증서를 붙였다면 반드시 true.
#   false → http://localhost 로 시험할 때만. 이대로 인터넷에 올리면
#           리프레시 토큰이 평문으로 오갑니다.
#
# 로컬에서 그냥 띄워 보려는 것이면 false 로 두고, 배포할 때 true 로 바꾸세요.
SECURE_COOKIE=false

# ---------------------------------------------------------------------- 기타
# nginx 를 거쳐 오는 브라우저는 같은 주소라 CORS 를 타지 않습니다.
# 화면을 따로 띄워(expo start --web, 기본 8081) 붙일 때만 씁니다.
CORS_ORIGINS=http://localhost:8081

# 웹을 호스트의 어느 포트로 열지.
WEB_PORT=8080
