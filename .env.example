# ============================================================================
#  docker-compose.yml 이 읽는 값들
#  ---------------------------------------------------------------------------
#    cp .env.example .env
#  하고 채운 뒤 `docker compose up -d --build` 하세요.
#  .env 는 커밋하지 않습니다(.gitignore).
# ============================================================================

# ---------------------------------------------------------------------- DB
DB_NAME=fit
DB_USER=fit
# 아무 문자열이나가 아니라, 만들어 낸 값이어야 합니다.
#   openssl rand -base64 24
DB_PASSWORD=

# --------------------------------------------------------------------- 토큰
# 액세스 토큰에 서명하는 열쇠입니다. 32바이트 이상.
#   openssl rand -base64 48
# 바꾸면 이미 나가 있는 토큰이 전부 무효가 됩니다(전원 재로그인).
JWT_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --------------------------------------------------------------------- 설치
# 최초 운영자를 만들 때 화면에서 한 번 입력하는 값입니다. 이게 없으면
# 배포 직후 아무나 첫 운영자 자리를 가져갈 수 있습니다.
#   openssl rand -hex 16
# 운영자를 만든 뒤에는 비워 두고 다시 띄우는 편이 좋습니다.
SETUP_TOKEN=

# --------------------------------------------------------------------- 쿠키
# 리프레시 쿠키에 Secure 를 붙일지.
#
#   true  → HTTPS 로만 실립니다. 도메인에 인증서를 붙였거나 Cloudflare 터널
#           뒤에 있다면 반드시 true.
#   false → http://localhost 로 시험할 때만. 이대로 인터넷에 올리면
#           리프레시 토큰이 평문으로 오갑니다.
SECURE_COOKIE=false

# ---------------------------------------------------------------------- 기타
# nginx 를 거쳐 오는 브라우저는 같은 주소라 CORS 를 타지 않습니다.
# 화면을 따로 띄워(expo start --web, 기본 8081) 붙일 때만 씁니다.
CORS_ORIGINS=http://localhost:8081

# 웹을 호스트의 어느 포트로 열지.
WEB_PORT=8080

# 그 포트를 어느 주소에 묶을지.
#
#   0.0.0.0    같은 공유기 안의 다른 기기(폰 등)에서도 붙을 수 있습니다.
#   127.0.0.1  이 서버 안에서만. 터널로 열 때는 이쪽이 맞습니다 —
#              바깥에서 들어오는 길을 터널 하나로 좁힙니다.
WEB_BIND=0.0.0.0

# ------------------------------------------------------------------- 지도
# 구글 지도 키 (선택).
#
# 넣으면 일정 화면에 지도가 뜨고, 장소를 이름으로 찾아 좌표를 채웁니다.
# 없으면 지도와 검색이 조용히 빠지고 나머지는 그대로 돕니다.
#
# 필요한 API: Maps JavaScript API, Places API
# 이 값은 브라우저 번들에 박히므로 구글 콘솔에서 HTTP 리퍼러 제한을 거세요.
# 바꾸면 프론트 이미지를 다시 빌드해야 반영됩니다(--build).
EXPO_PUBLIC_GMAPS_KEY=

# ----------------------------------------------------------------- 터널
# Cloudflare 터널 토큰 (선택).
#
# 공유기 포트를 열지 않고 밖에서 들어올 수 있게 합니다. Zero Trust 대시보드
# > Networks > Tunnels 에서 터널을 만들면 나오는 토큰입니다.
#
#   docker compose --profile tunnel up -d --build
#
# 토큰은 그 자체로 터널에 붙을 수 있는 자격이라 비밀번호처럼 다루세요.
TUNNEL_TOKEN=
